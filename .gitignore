# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Logs
*.log
# Но не тестовые данные: правило выше уже съело
# tests/fixtures/winws2_debug_sample.log, из-за чего десять тестов
# разбора логов падали в любой свежей копии репозитория.
!tests/fixtures/*.log

# Runtime user state
/settings/

# Списки хостов. Поставляемые нужны в репозитории: на них ссылается
# каждый встроенный пресет строкой вида --hostlist=lists/discord.txt,
# и без них собранный выпуск запускается, но обход не работает.
#
# Правило /lists/ исключало папку целиком — вместе со 123 файлами
# поставляемых списков. Оно писалось под пользовательские, а те лежат
# в подпапке user и исключены отдельно.
/lists/user/
/lists/autohostlist.txt

# Local config
.env.local

# Перечень сторонних лицензий временно снят с публикации по просьбе.
# Локальная копия остаётся: сами обязательства никуда не делись, и
# вернуть файл в репозиторий проще, чем собирать его заново.
THIRD_PARTY_LICENSES.md

# Build secrets (autogenerated, never commit)
_build_secrets.py

# Nuitka crash diagnostics (generated after a failed compilation)
nuitka-crash-report.xml

# Результаты сборки. Пересоздаются из исходников, весят десятки мегабайт
# и в публичном репозитории означали бы, что скачавший получает наш
# собранный exe вместо своего.
#
# Правило build/ выше сюда не годится: оно ловит только каталог с таким
# именем, а у нас их три и зовутся они иначе.
/artifact/
/build-local/
/installer/output/

# Пробные файлы, оставленные при проверках. Имена говорящие: если такой
# файл попал в репозиторий, значит проверку забыли убрать.
*probe-remove-me*
/lists/.probe

# AI/Dev config (private)
CLAUDE.md
AGENTS.md
.claude/
.editorconfig
src/config/build_info.py
/docs/changelog
docs/gui_preset_profile_architecture_plan.md
www_youtube_com.txt
/.codex
/docs
/logs
/.superpowers
/.codex
/.agent

# Иконки. Исключение осталось от исходного проекта — там их подкладывали
# при сборке. У нас значок собирается из макета и лежит в репозитории,
# иначе собранный exe остался бы без него.
/ico/*
/src/ico/*
!/ico/net67.ico
!/src/ico/net67.ico
!/src/ico/net67_1024.png

# Тестовый прогон
.pytest_cache/

# Движок обхода и клиент туннеля едут в репозиторий.
#
# Здесь стояло исключение для /exe/ целиком — с расчётом, что бинарники
# собирают отдельно. Для публичного репозитория это не годится: сборка
# на GitHub без winws.exe, WinDivert.dll и драйвера даёт интерфейс,
# которому нечего запускать, и кнопка «Включить» молча не работает у
# всех, кто скачал выпуск.
#
# Цена решения — 23 МБ бинарников в репозитории и то, что драйвер .sys
# иногда забирают антивирусы прямо при скачивании. Обе беды лучше, чем
# заведомо нерабочий выпуск.
#
# Распакованные исходники клиента AmneziaWG по-прежнему не нужны: это
# ещё ~14 МБ, и для сборки они не требуются.
/amneziawg-windows-client-*/

# Исходник логотипа
/net67 Logo.html
