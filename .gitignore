# tests/fixtures/winws2_debug_sample.log, из-за чего десять тестов
# разбора логов падали в любой свежей копии репозитория.
!tests/fixtures/*.log

# Runtime user state
/settings/

# Списки хостов. Поставляемые нужны в репозитории: на них ссылается
# каждый встроенный пресет строкой вида --hostlist=lists/discord.txt,
# и без них собранный выпуск запускается, но обход не работает.
#
# Правило /lists/ исключало папку целиком — вместе со 123 файлами
# поставляемых списков. Оно писалось под пользовательские, а те лежат
# в подпапке user и исключены отдельно.
/lists/user/
/lists/autohostlist.txt

# Local config
.env.local

# Перечень сторонних лицензий временно снят с публикации по просьбе.
# Локальная копия остаётся: сами обязательства никуда не делись, и
# вернуть файл в репозиторий проще, чем собирать его заново.
THIRD_PARTY_LICENSES.md

# Build secrets (autogenerated, never commit)
_build_secrets.py

# Nuitka crash diagnostics (generated after a failed compilation)
nuitka-crash-report.xml

# Результаты сборки. Пересоздаются из исходников, весят десятки мегабайт
# и в публичном репозитории означали бы, что скачавший получает наш
# собранный exe вместо своего.
#
# Правило build/ выше сюда не годится: оно ловит только каталог с таким
# именем, а у нас их три и зовутся они иначе.
/artifact/
/build-local/
/installer/output/

# Пробные файлы, оставленные при проверках. Имена говорящие: если такой
# файл попал в репозиторий, значит проверку забыли убрать.
*probe-remove-me*
/lists/.probe

# Windows-путь, случайно ставший именем файла.
#
# hosts.HOSTS_PATH вне Windows брал тот же литерал
# C:\Windows\System32\drivers\etc\hosts, а на Linux это не путь, а имя
# файла из одного куска. Прогон тестов создавал такой файл прямо в корне
# репозитория. Причина устранена, строки ниже остаются сторожем.
#
# Правил два, и это не перестраховка. Двоеточие и обратный слэш в именах
# файлов Windows запрещены, поэтому при переносе тома они подменяются
# символами из области частного использования Unicode. Одно и то же имя
# на Linux и на Windows выглядит для git по-разному: правило /C:* ловит
# только первое написание, и файл, отсеянный на одной стороне, спокойно
# уехал в публикацию с другой. Так он и попал в выпуск 0.3.67.
#
# Второе правило написано без запрещённых символов и ловит оба
# написания: имя начинается на C и заканчивается на hosts, в корне
# репозитория ничего похожего быть не может.
/C:*
/C*hosts

# Генератор вики. В репозиторий не едет.
#
# Это отдельный проект (Quartz) со своими зависимостями: четверть
# гигабайта в node_modules, и всё это восстанавливается одной командой.
# Хранить чужой пакетный кэш в своём репозитории незачем.
#
# Что едет: `wiki\content` — статьи, `wiki\site` — собранный сайт,
# настройки и скрипты. Собранный сайт нужен именно в репозитории:
# сборка приложения копирует его в папку `docs`, откуда его открывает
# раздел «Документация». Не будет его здесь — CI соберёт выпуск, в
# котором кнопка открывает пустоту.
/wiki/engine/

# Записка для переноса работы на другой компьютер.
#
# Внутренний документ: про кого приложение, что в нём переделано и что
# ещё не доделано. Публиковать это незачем.
#
# Один раз его уже убирали из репозитория — и он вернулся со следующим
# `git add -A`, потому что удалили файл, а правило не завели. Поэтому
# строка здесь, а не только `git rm --cached`.
/HANDOVER.md

# Файл сборки PyInstaller.
#
# Его пишет сам PyInstaller при каждом прогоне scripts\build_local.ps1,
# и в datas и icon он подставляет абсолютные пути той машины, где шла
# сборка — вместе с именем пользователя Windows. В репозитории уже
# лежала версия с C:\Users\User\..., следующая сборка на другой машине
# переписывала её своим путём: бесконечный шум в diff и чужое имя в
# публичном репозитории. Сборка spec-файл не читает — она собирает
# аргументы сама, так что хранить его незачем.
/net67.spec

