; Оформление установщика net67: тёмное окно, свои картинки и свои слова.
;
; Подключается из net67.iss строкой #include. Вынесено отдельно, чтобы
; внешний вид можно было собрать и посмотреть без самой программы:
; настоящий установщик требует прав администратора и останавливает
; обход, а оформлению это не нужно.
;
; Стандартный установщик Inno Setup — светлое окно с синим компьютером и
; словами «Вас приветствует Мастер установки». Программа при этом
; чёрно-белая, и первое, что видел человек, выглядело чужим.
;
; Картинки лежат в art\ и рисуются скриптом tools\make_installer_art.py.

; Папка с картинками. Задаётся снаружи, если скрипт лежит не рядом.
#ifndef ArtDir
  #define ArtDir "art"
#endif

[Setup]
; modern — крупное окно без рамок вокруг страниц; dark — тёмное всегда,
; как сама программа, а не по настройке Windows; includetitlebar красит
; и заголовок окна, иначе над тёмным окном остаётся белая полоса;
; hidebevels убирает разделительные линии.
WizardStyle=modern dark hidebevels includetitlebar

; Боковая панель первой и последней страниц и значок в шапке остальных.
; Несколько размеров: установщик берёт ближайший к масштабу экрана.
WizardImageFile={#ArtDir}\side-*.png
WizardSmallImageFile={#ArtDir}\small-*.png

; Страница приветствия. По умолчанию она выключена, и установка
; начиналась сразу с вопроса про папку — без единого слова о том, что
; это за программа.
DisableWelcomePage=no

[Messages]
russian.WelcomeLabel1=Установка [name]
russian.WelcomeLabel2=[name/ver] восстанавливает доступ к сайтам и сервисам, которые перестали открываться.%n%nУстановка займёт меньше минуты. Если [name] уже установлен, он обновится: настройки, пресеты и списки сохранятся.
russian.SelectDirDesc=Куда установить [name]?
russian.SelectDirLabel3=[name] будет установлен в эту папку.
russian.SelectDirBrowseLabel=Нажмите «Далее», чтобы продолжить. Другую папку можно выбрать кнопкой «Обзор».
russian.WizardSelectTasks=Ярлык и автозапуск
russian.SelectTasksDesc=Что сделать вместе с установкой?
russian.SelectTasksLabel2=Отметьте нужное и нажмите «Далее». Автозапуск можно поменять позже в самой программе.
russian.WizardReady=Всё готово
russian.ReadyLabel1=Осталось нажать «Установить».
russian.ReadyLabel2a=Нажмите «Установить», чтобы продолжить, или «Назад», чтобы что-то изменить.
russian.ReadyLabel2b=Нажмите «Установить», чтобы продолжить.
russian.InstallingLabel=[name] устанавливается. Это займёт меньше минуты.
russian.FinishedHeadingLabel=[name] установлен
russian.FinishedLabelNoIcons=Программа готова к работе.%n%nПри первом запуске она проведёт короткую экскурсию и задаст несколько вопросов.
russian.FinishedLabel=Программа готова к работе. Открыть её можно значком на рабочем столе или из меню «Пуск».%n%nПри первом запуске она проведёт короткую экскурсию и задаст несколько вопросов.
russian.ClickFinish=Нажмите «Завершить», чтобы закрыть установщик.
